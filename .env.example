# Runtime
NODE_ENV=development
DEPLOYMENT_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3001

# PostgreSQL / Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_POOL_MAX=3
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=10000

# Supabase Storage (server-only)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TESTIMONY_PHOTOS_BUCKET=testimony-photos

# Built-in email automation (server-only; never prefix these with NEXT_PUBLIC_).
# Gmail SMTP with a Google App Password (about 500 emails a day on a personal account).
# Leave SMTP_USER or SMTP_PASSWORD blank to keep every notification queued, not sent.
SMTP_HOST=smtp.gmail.com
# 465 uses implicit TLS; 587 upgrades with STARTTLS.
SMTP_PORT=465
SMTP_USER=
# The 16-character App Password from Google Account > Security > App passwords.
SMTP_PASSWORD=
# Sender shown to recipients, for example: Zion Events Place <your-account@gmail.com>
# Defaults to SMTP_USER. Gmail only sends as the signed-in account or a verified alias.
MAIL_FROM=
# Fallback staff inboxes for inquiry and booking request alerts, the daily digest and staff
# calendar invitations (comma-separated, up to five, 255 characters in total). Used only while
# Admin > Settings > Communications has no staff notification emails. Defaults to SMTP_USER.
STAFF_NOTIFICATION_EMAIL=
# Protects /api/cron/automation (Authorization: Bearer <secret>). Use at least 32 random
# characters, for example the output of: openssl rand -hex 32. Vercel Cron sends it automatically.
CRON_SECRET=

# Zeni, the website concierge (server-only). A free Gemini API key from Google AI Studio lets Zeni
# phrase answers from Zion's published information in English, Filipino or Taglish. The free tier
# may use prompts to improve Google products, so Zeni redacts personal details and sends only public
# excerpts (docs/chatbot.md). Leave GEMINI_API_KEY blank to keep Zeni on its built-in answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ZENI_LLM_ENABLED=true

# Admin authentication (server-only; generate a random secret of at least 32 bytes)
AUTH_SECRET=
AUTH_URL=http://localhost:3001

# Optional temporary access for a local development server and local database.
# Explicitly enable only with an existing admin email, SHA-256 token hash, and expiry.
ADMIN_LOCAL_ACCESS_ENABLED=false
ADMIN_LOCAL_ACCESS_EMAIL=
ADMIN_LOCAL_ACCESS_TOKEN_HASH=
ADMIN_LOCAL_ACCESS_UNTIL=

# Developer Command Center: disabled until accounts, MFA, and server settings exist.
# Independent of client/admin roles. Never prefix these keys with NEXT_PUBLIC_.
DEVELOPER_PANEL_ENABLED=false
DEVELOPER_ORIGIN=http://localhost:3001
DEVELOPER_EMAIL_ALLOWLIST=
DEVELOPER_ENCRYPTION_KEY=
# Optional, explicitly enabled seven-day loopback-only development access.
# Production and remote databases always reject this exception. Dates do not auto-renew.
DEVELOPER_LOCAL_ACCESS_ENABLED=false
DEVELOPER_LOCAL_ACCESS_ID=
DEVELOPER_LOCAL_ACCESS_STARTED_AT=
DEVELOPER_LOCAL_ACCESS_UNTIL=
# Production only: >=43-character random secret injected by a private trusted gateway.
# Strip incoming x-zion-developer-gateway headers at ingress. Block direct origin access.
DEVELOPER_GATEWAY_SECRET=
# Separate >=43-character random token, scoped to published knowledge and topic reports.
DEVELOPER_KNOWLEDGE_TOKEN=
