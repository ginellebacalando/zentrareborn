{
  "name": "zion-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "dev:local": "node scripts/dev-local.mjs",
    "fonts:licensed": "node scripts/install-licensed-fonts.mjs",
    "build": "next build --webpack",
    "start": "next start --port 3001",
    "postinstall": "prisma generate",
    "lint": "eslint . --max-warnings=0",
    "check:client-boundary": "node scripts/check-client-boundary.mjs",
    "check:hygiene": "node scripts/check-project-hygiene.mjs",
    "test": "node scripts/check-removed-features.mjs && npm run test:chatbot && npm run test:admin && npm run test:automation && npm run test:developer",
    "test:chatbot": "node --conditions=react-server --import tsx --test --test-concurrency=1 lib/chatbot/retrieval.test.ts lib/chatbot/request.test.ts lib/chatbot/conversation.test.ts lib/chatbot/session-security.test.ts lib/chatbot/language.test.ts lib/chatbot/redaction.test.ts lib/chatbot/llm.test.ts lib/chatbot/prefill.test.ts lib/chatbot/integration.test.ts lib/chatbot/live-chat.test.ts services/orchestration/receptionist-calendar.test.ts",
    "db:receptionist:check": "node scripts/install-receptionist-schema.mjs",
    "test:admin": "node --conditions=react-server --import tsx --test lib/admin/domain.test.ts lib/admin/integration.test.ts lib/admin/local-access.test.ts lib/admin/dashboard.test.ts lib/admin/analytics.test.ts lib/admin/website-activity.test.ts lib/admin/payment-proofs.test.ts",
    "db:admin:check": "node scripts/install-admin-schema.mjs",
    "db:automation:check": "node scripts/install-automation-schema.mjs",
    "db:booking-holds:check": "node scripts/install-booking-holds-schema.mjs",
    "db:demo:setup": "node scripts/setup-demo-database.mjs",
    "db:live-chat:check": "node scripts/install-live-chat-schema.mjs",
    "db:payment-proofs:check": "node scripts/install-payment-proofs-schema.mjs",
    "automation:run": "node --conditions=react-server --import tsx scripts/run-automation.ts",
    "test:automation": "node --conditions=react-server --import tsx --test lib/automation/ics.test.ts lib/automation/automation.test.ts",
    "typecheck": "tsc --noEmit",
    "developer:setup": "node --conditions=react-server --import tsx scripts/developer-setup.mts",
    "test:developer": "node --conditions=react-server --import tsx --test lib/developer/security.test.ts lib/developer/local-access.test.ts lib/developer/integration.test.ts",
    "developer:local-access": "node --conditions=react-server --import tsx scripts/enable-local-developer.mts",
    "developer:preview": "node --conditions=react-server --import tsx scripts/preview-developer.mts",
    "db:generate": "prisma generate",
    "verify": "npm run format:check && npm run check:design && npm run check:client-boundary && npm run check:hygiene && npm run typecheck && npm run test && npm run lint && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:design": "node scripts/check-design-system.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.17.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.5.0",
    "otpauth": "9.6.0",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "swr": "2.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "pglite-server": "0.1.5",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "overrides": {
    "mysql2": "3.24.5",
    "nodemailer": "10.5.0",
    "postcss": "8.5.25",
    "sharp": "0.35.5"
  }
}
